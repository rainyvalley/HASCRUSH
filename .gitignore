# Crush runtime state created by developing/testing the add-on on this host:
# never snapshot these (could contain provider stores / session history).
.local/
.crush/
# Python bytecode from the release-pin scripts
__pycache__/
# Local pre-change backups (e.g. Dockerfile.bak kept while bumping a pin):
# working files, never part of the add-on build.
*.bak
